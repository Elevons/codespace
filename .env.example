# Codespace reads this file as .env, beside package.json, when the server starts.

# --- The chat's model ----------------------------------------------------
# Any OpenAI-compatible endpoint: OpenRouter, llama-swap, vLLM, LM Studio, and so on.
# The base URL stops before /chat/completions.
CODESPACE_MODEL_BASE_URL=https://openrouter.ai/api/v1
CODESPACE_MODEL=deepseek/deepseek-v4.1-flash
CODESPACE_MODEL_CONTEXT=131072
CODESPACE_MODEL_MAX_TOKENS=16384

# The key, given directly...
CODESPACE_MODEL_API_KEY=
# ...or read by name from another program's env file, so it is not copied.
# CODESPACE_MODEL_KEY_FILE=/path/to/other/.env
# CODESPACE_MODEL_KEY_NAME=MODEL_API_KEY
